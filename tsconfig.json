{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": [
        "AppCyra/*"
      ]
    }
  },
  "include": [
    "AppCyra/**/*.ts",
    "AppCyra/**/*.tsx",
    "AppCyra/**/*.d.ts"
  ]
}